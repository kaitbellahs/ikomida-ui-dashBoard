{
  "name": "ikomida-dashboard",
  "version": "1.0.0",
  "private": true,
  "author": "Khalid Ait Bellahs",
  "license": "UNLICENSED",
  "scripts": {
    "build": "rollup -c --environment ENV:prod && yarn cap copy && yarn cap sync",
    "dev": "rollup -c -w",
    "prod": "rollup -c -w --environment ENV:prod",
    "start": "sirv public --no-clear",
    "build:android": "run-s build cap-run:android",
    "build:ios": "run-s build:app cap-run:ios",
    "cap-run:android": "cap sync android && cap open android",
    "cap-run:ios": "cap sync ios && cap run ios",
    "dev:ios": "run-p build cap-run:ios",
    "dev:android": "run-p dev:start cap-run:android"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^22.0.0",
    "@rollup/plugin-node-resolve": "^13.3.0",
    "@rollup/plugin-replace": "^4.0.0",
    "node-sass": "^7.0.1",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.4.5",
    "postcss-load-config": "^3.1.1",
    "rollup": "^2.3.4",
    "rollup-plugin-css-only": "^3.1.0",
    "rollup-plugin-livereload": "^2.0.0",
    "rollup-plugin-svelte": "^7.0.0",
    "rollup-plugin-terser": "^7.0.0",
    "svelte": "^3.0.0",
    "svelte-as-markup-preprocessor": "^0.3.0",
    "svelte-fa": "^2.4.0",
    "svelte-preprocess": "^4.10.1",
    "svelte-preprocess-cssmodules": "^2.1.2"
  },
  "dependencies": {
    "@capacitor-community/http": "^1.4.1",
    "@capacitor/android": "^3.3.4",
    "@capacitor/app": "^1.0.7",
    "@capacitor/app-launcher": "^1.0.9",
    "@capacitor/cli": "^3.3.4",
    "@capacitor/clipboard": "^1.0.8",
    "@capacitor/core": "^3.3.4",
    "@capacitor/geolocation": "^1.3.0",
    "@capacitor/ios": "^3.3.4",
    "@capacitor/network": "^1.0.6",
    "@capacitor/push-notifications": "^1.0.9",
    "@capacitor/status-bar": "github:TIAltoNivel/capacitor-plugin-statusbar",
    "@capacitor/storage": "^1.2.3",
    "@fortawesome/free-solid-svg-icons": "^6.1.1",
    "@ikomida/components": "github:TIAltoNivel/ikomida-components",
    "capacitor-native-log": "^0.2.0",
    "react-image-file-resizer": "^0.4.8",
    "sirv-cli": "^2.0.0",
    "uuid": "^8.3.2"
  }
}
